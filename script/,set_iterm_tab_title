#!/usr/bin/env bash
# ,set_iterm_tab_title - set the current iTerm2 tab title.
#
# Usage:
#   ,set_iterm_tab_title "my tab name"
#
# Prints the OSC 1 escape sequence, so it works in any terminal that honours it.
# For Terminal.app with profile colors, use ,set_terminal_tab_title.

set -euo pipefail

case "${1:-}" in -h|--help) sed -n '2s/^# \{0,1\}//p' "$0"; exit 0;; help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0;; esac

if [ $# -eq 0 ]; then
	echo ",set_iterm_tab_title: needs a title (see --help)" >&2
	exit 2
fi

printf '\033]1;%s\007' "$*"
