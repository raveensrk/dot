#!/usr/bin/env bash
# ,set_terminal_tab_title - rename the current Terminal.app tab, optionally with a colored profile.
#
# Usage:
#   ,set_terminal_tab_title "my tab name"              # rename current tab
#   ,set_terminal_tab_title -p Prod "prod - careful"   # rename AND switch to the "Prod" profile
#   ,set_terminal_tab_title -p Dev                     # just switch profile, keep name
#
# Notes:
#   * Terminal.app cannot color individual tab titles. "Color" is achieved by
#     switching the tab to a Terminal *profile* that has its own background/text
#     colors. Create profiles in Terminal > Settings > Profiles first, e.g.
#     "Prod" (red bg) and "Dev" (green bg), then pass their names with -p.
#   * Emoji in the title (e.g. "🔴 prod") is the other lightweight color cue.
#   * To stop Terminal overwriting the name, uncheck the dynamic title
#     components in Settings > Profiles > <profile> > Tab.

set -euo pipefail

case "${1:-}" in -h|--help) sed -n '2s/^# \{0,1\}//p' "$0"; exit 0;; help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0;; esac

profile=""
while getopts ":p:" opt; do
  case "$opt" in
    p) profile="$OPTARG" ;;
    \?) echo ",set_terminal_tab_title: unknown option -$OPTARG" >&2; exit 2 ;;
    :)  echo ",set_terminal_tab_title: -$OPTARG needs an argument" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

name="${*:-}"

# Set the tab/window title via OSC escape (only if a name was given).
if [ -n "$name" ]; then
  printf '\033]0;%s\007' "$name"
fi

# Switch the current tab to a colored profile via AppleScript.
if [ -n "$profile" ]; then
  osascript -e "tell application \"Terminal\" to set current settings of selected tab of front window to settings set \"$profile\"" \
    || { echo ",set_terminal_tab_title: no Terminal profile named '$profile' (create it in Settings > Profiles)" >&2; exit 1; }
fi
