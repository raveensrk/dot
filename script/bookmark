#!/usr/bin/env python3
"""bookmark - one writer for every self-describing bookmark file on this machine.

A file is a sink only if it describes itself: YAML front matter with a
`bookmarks:` key. Nothing else is ever read or written, so a redirect stub or a
stray study note is invisible by construction.

    ---
    bookmarks:
      scope: work and technical links - agents, FPGA, electronics
      default_section: Read Later
      order: newest-last
    ---

COMMANDS
  bookmark URL             add a link
  bookmark                 list every link; with a terminal, fzf-pick one and open it
  bookmark list [--json]   the sinks, their scope, their counts
  bookmark check           validate the protocol; exit 1 on findings
  bookmark describe FILE   write or update that file's front matter
  bookmark --help          this guide

FINDING THE SINK, in order
  1. --to FILE, with --section NAME for the section
  2. Jev: which sink, then which section, each only at 0.6 confidence or better
  3. the fzf picker, when a terminal is attached
  4. otherwise it stops and prints the candidates, exit 2

  Jev is asked the sink and the section as two separate questions, and sees one
  sink's scope sentence plus its section names, never the file body: its
  accuracy falls with a large state, and a single 24-option choice is a coin
  toss.

WHERE THE LINE LANDS
  --section NAME           that heading. It must exist, unless it is the file's
                           default_section, which is created at the end of the
                           file when missing. Any other new heading needs
                           --new-section, because inventing a category is a
                           judgement call rather than a deterministic write.
  order: newest-last       appended at the end of the section (the default)
  order: newest-first      inserted directly under the heading

  The order key is per file, not per section, so a section with its own
  convention keeps the end-of-section position until that changes.

DUPLICATES
  A link already present in ANY sink is refused with the file and the line, exit
  1, and nothing is written. The comparison ignores http:// against https://, a
  leading www. and a trailing slash. --force writes the second copy anyway.
  `bookmark check` reports the duplicates that are already in the files.

THE LINK TEXT
  --title "text"           use this
  otherwise                the page's own <title>, fetched with an 8 second timeout
  otherwise                the last path segment of the url

EXAMPLES
  bookmark https://example.com/article
  bookmark https://example.com/x --to "~/repos/work/bookmarks.md"
  bookmark https://example.com/x --to "repos/work/bookmarks.md" --section FPGA
  bookmark https://example.com/x --dry-run
  bookmark --json | python3 -c "import json,sys; print(json.load(sys.stdin)[0])"
  bookmark describe ~/repos/notes/Recipes.md --scope "recipes I actually cook"
  bookmark check

IN A TERMINAL, AND INSIDE AN AGENT
  Same script, different terminals, and this was measured rather than assumed:
  inside a pi tool call /dev/tty does not exist, so no fzf path can run and
  neither can it hang. There, `bookmark` prints every link url first with
  [file :: section] and opens nothing, and adding goes through --to or a
  confident Jev answer. `bookmark --json` returns objects whose "file" value
  feeds straight back into --to.

EXIT CODES
  0 wrote it, or listed it
  1 refused: already in a sink. Nothing was written
  2 bad call, or no route and no terminal to ask on

FILES
  ~/dot/script/bookmark              this script, on PATH via ~/dot/script
  ~/dot/tests/test_bookmark.py       18 offline checks, no network
  ~/repos/**/bookmark*.md            the sinks, plus ~/iCloud for the iCloud ones
"""
from __future__ import annotations

import argparse
import json
import html
import os
import re
import subprocess
import sys
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path

import yaml

HOME = Path.home()
ROOTS = [HOME / "repos", HOME / "iCloud"]
SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "__pycache__", ".Trash"}
NAME = re.compile(r"^bookmarks?\.md$", re.IGNORECASE)
HEADING = re.compile(r"^##\s+(.*?)\s*$")
LINK = re.compile(r"^\s*-\s+(?:\[([^\]]*)\]\((\S+?)\)|<(\S+?)>)")
JEV_CONFIDENCE = 0.6
JEV_URL = "https://api.typesafe.ai/v1/systemone"
JEV_MODEL = "jev-latest"
TITLE_TIMEOUT = 8


@dataclass
class Sink:
    path: Path
    scope: str
    default_section: str
    order: str
    sections: list[str] = field(default_factory=list)
    text: str = ""

    @property
    def short(self) -> str:
        try:
            return "~/" + str(self.path.relative_to(HOME))
        except ValueError:
            return str(self.path)


def roots() -> list[Path]:
    override = os.environ.get("BOOKMARK_ROOTS")
    if override:
        return [Path(p).expanduser() for p in override.split(":") if p]
    return ROOTS


def front_matter(text: str) -> dict:
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end == -1:
        return {}
    try:
        loaded = yaml.safe_load(text[3:end]) or {}
    except yaml.YAMLError:
        return {}
    return loaded if isinstance(loaded, dict) else {}


def headings(text: str) -> list[str]:
    return [m.group(1) for line in text.splitlines() if (m := HEADING.match(line))]


def discover() -> list[Sink]:
    sinks = []
    for root in roots():
        if not root.is_dir():
            continue
        for directory, subdirs, files in os.walk(root):
            subdirs[:] = [d for d in subdirs if d not in SKIP_DIRS]
            for name in sorted(files):
                if not NAME.match(name) or name.endswith(".icloud"):
                    continue
                path = Path(directory) / name
                try:
                    text = path.read_text(encoding="utf-8", errors="replace")
                except OSError:
                    continue
                meta = front_matter(text).get("bookmarks")
                if not isinstance(meta, dict):
                    continue
                sinks.append(
                    Sink(
                        path=path,
                        scope=str(meta.get("scope", "")).strip(),
                        default_section=str(meta.get("default_section", "Read Later")).strip(),
                        order=str(meta.get("order", "newest-last")).strip(),
                        sections=headings(text),
                        text=text,
                    )
                )
    return sorted(sinks, key=lambda s: s.short)


def normalize(url: str) -> str:
    stripped = re.sub(r"^https?://", "", url.strip().rstrip("/"))
    stripped = re.sub(r"^www\.", "", stripped, flags=re.IGNORECASE)
    return stripped.split("#", 1)[0]


def existing(url: str, sinks: list[Sink]) -> tuple[Sink, int] | None:
    want = normalize(url)
    for sink in sinks:
        for number, line in enumerate(sink.text.splitlines(), start=1):
            match = LINK.match(line)
            if match and normalize(match.group(2) or match.group(3)) == want:
                return sink, number
    return None


def fetch_title(url: str) -> str:
    """The page title, or the last path segment when the fetch gives nothing."""
    try:
        done = subprocess.run(
            ["curl", "-fsSL", "--max-time", str(TITLE_TIMEOUT), url],
            capture_output=True,
            text=True,
            timeout=TITLE_TIMEOUT + 4,
        )
        match = re.search(r"<title[^>]*>(.*?)</title>", done.stdout, re.S | re.I)
        if match:
            title = html.unescape(re.sub(r"\s+", " ", match.group(1))).strip()
            if title:
                return title
    except (subprocess.SubprocessError, OSError):
        pass
    tail = url.rstrip("/").rsplit("/", 1)[-1]
    return tail or url


def new_lines(sink: Sink, section: str, entry: str) -> list[str]:
    """The sink's text with the entry placed in `section` per the declared order."""
    lines = sink.text.splitlines()
    starts = [i for i, line in enumerate(lines) if HEADING.match(line) and HEADING.match(line).group(1) == section]
    if not starts:
        if not lines or lines[-1].strip():
            lines.append("")
        lines += [f"## {section}", "", entry]
        return lines
    start = starts[0]
    end = next(
        (i for i in range(start + 1, len(lines)) if HEADING.match(lines[i])),
        len(lines),
    )
    if sink.order == "newest-first":
        insert = start + 1
        if insert < len(lines) and lines[insert].strip() == "":
            lines.insert(insert + 1, entry)
        else:
            lines.insert(insert, entry)
        return lines
    insert = end
    while insert > start + 1 and lines[insert - 1].strip() == "":
        insert -= 1
    # a heading follows: keep one blank line between the entry and it. At the end
    # of the file there is nothing to separate, and appending a blank line there
    # only added a dangling line to every add (a stray diff in git).
    if end < len(lines):
        lines.insert(insert, entry)
        if insert + 1 >= len(lines) or lines[insert + 1].strip() != "":
            lines.insert(insert + 1, "")
    else:
        lines.insert(insert, entry)
    return lines


def jev_choice(state: dict, question: str, criteria: dict[str, str]) -> tuple[str, float]:
    """One TypeSafe call. Raises RuntimeError without a key or a usable answer."""
    key = os.environ.get("TYPESAFE_API_KEY")
    if not key:
        raise RuntimeError("TYPESAFE_API_KEY not set")
    body = json.dumps(
        {
            "model": JEV_MODEL,
            "state": state,
            "questions": {
                "pick": {
                    "type": "choice",
                    "instructions": {"question": question},
                    "criteria": criteria,
                }
            },
        }
    ).encode()
    request = urllib.request.Request(
        JEV_URL,
        data=body,
        headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        answer = json.load(response)["answers"]["pick"]
    if answer.get("type") != "choice":
        raise RuntimeError("unexpected answer shape: " + json.dumps(answer)[:120])
    return str(answer.get("choice")), float(answer.get("confidence") or 0.0)


def route_by_jev(url: str, title: str, sinks: list[Sink]) -> tuple[Sink, str] | None:
    """Two choices: the sink, then a section inside it. None when Jev is unsure."""
    if len(sinks) < 2:
        return (sinks[0], route_section(url, title, sinks[0])) if sinks else None
    state = {
        "link": url,
        "title": title,
        "sinks": [{"id": f"s{i}", "file": s.short, "scope": s.scope} for i, s in enumerate(sinks, 1)],
    }
    criteria = {f"s{i}": f"{s.short} - {s.scope}" for i, s in enumerate(sinks, 1)}
    choice, confidence = jev_choice(state, "Which bookmark file should this link go in?", criteria)
    if confidence < JEV_CONFIDENCE:
        return None
    sink = sinks[int(choice[1:]) - 1]
    return sink, route_section(url, title, sink)


def route_section(url: str, title: str, sink: Sink) -> str:
    if len(sink.sections) < 2:
        return sink.default_section
    state = {"link": url, "title": title, "file": sink.short, "scope": sink.scope}
    criteria = {name: f"section {name}" for name in sink.sections}
    criteria[sink.default_section] = f"{sink.default_section} - the catch-all capture section"
    try:
        choice, confidence = jev_choice(state, "Which section of this file should the link go in?", criteria)
    except RuntimeError:
        return sink.default_section
    return choice if confidence >= JEV_CONFIDENCE else sink.default_section


def has_tty() -> bool:
    try:
        with open("/dev/tty"):
            return True
    except OSError:
        return False


def pick(options: list[str], prompt: str = "select") -> str | None:
    """fzf over the options; None when there is no terminal to draw on."""
    if not has_tty():
        return None
    done = subprocess.run(
        ["fzf", "+s", "--prompt", prompt + "> "],
        input="\n".join(options),
        capture_output=True,
        text=True,
    )
    return done.stdout.strip() or None


def sink_line(sink: Sink) -> str:
    return f"{sink.short} :: {sink.scope or 'no scope written'}"


def cmd_list(sinks: list[Sink], as_json: bool) -> int:
    if as_json:
        print(
            json.dumps(
                [
                    {
                        "file": str(s.path),
                        "scope": s.scope,
                        "default_section": s.default_section,
                        "order": s.order,
                        "sections": s.sections,
                        "links": sum(1 for line in s.text.splitlines() if LINK.match(line)),
                    }
                    for s in sinks
                ],
                indent=1,
            )
        )
        return 0
    if not sinks:
        print("no sinks: a file needs bookmarks: front matter to count (bookmark describe FILE)")
        return 1
    for sink in sinks:
        links = sum(1 for line in sink.text.splitlines() if LINK.match(line))
        print(f"{sink.short}  ({links} links, {len(sink.sections)} sections, order {sink.order})")
        print(f"    scope: {sink.scope or 'MISSING'}")
        print(f"    default: {sink.default_section}")
    return 0


def cmd_check(sinks: list[Sink]) -> int:
    findings = []
    notes = []
    if not sinks:
        findings.append("no sinks found: nothing has bookmarks: front matter")
    seen: dict[str, str] = {}
    for sink in sinks:
        if not sink.scope:
            findings.append(f"{sink.short}: scope is empty")
        if sink.order not in ("newest-last", "newest-first"):
            findings.append(f"{sink.short}: order must be newest-last or newest-first, not {sink.order!r}")
        if sink.default_section not in sink.sections:
            # not a finding: the first add creates it, so this stays green
            notes.append(f"{sink.short}: no {sink.default_section!r} heading yet; the next add creates it")
        for number, line in enumerate(sink.text.splitlines(), start=1):
            match = LINK.match(line)
            if not match:
                continue
            url = match.group(2) or match.group(3)
            key = normalize(url)
            if key in seen:
                findings.append(f"{sink.short}:{number}: duplicate of {seen[key]} - {url}")
            else:
                seen[key] = f"{sink.short}:{number}"
            if not re.match(r"^https?://", url):
                findings.append(f"{sink.short}:{number}: not an http(s) url - {url}")
    for note in notes:
        print(f"note: {note}")
    for finding in findings:
        print(f"finding: {finding}")
    print(f"{len(sinks)} sinks, {len(seen)} distinct links, {len(findings)} findings, {len(notes)} notes")
    return 1 if findings else 0


def splice_front_matter(text: str, block: list[str]) -> str:
    """The bookmarks block into the existing front matter, other keys untouched.

    Re-serialising them with yaml.safe_dump rewrote quoting, folded long
    strings and appended `...` document-end markers to a published page, so the
    existing lines are carried over byte for byte instead.
    """
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return "\n".join(["---", *block, "---", ""]) + text.lstrip("\n")
    end = next((i for i in range(1, len(lines)) if lines[i].strip() in ("---", "...")), None)
    if end is None:
        return "\n".join(["---", *block, *lines[1:], "---", ""]) + "\n"
    kept, skip = [], False
    for line in lines[1:end]:
        if re.match(r"^bookmarks:\s*$", line):
            skip = True
            continue
        if skip and (line.startswith(" ") or not line.strip()):
            continue
        skip = False
        kept.append(line)
    return "\n".join(["---", *block, *kept, "---", *lines[end + 1 :]]) + "\n"


def cmd_describe(paths: list[str], scope: str | None, default_section: str, order: str) -> int:
    # one --scope cannot describe several files differently: the last value would
    # silently win for all of them, so this refuses instead
    if scope and len(paths) > 1:
        print("refused: --scope describes one file. Run describe once per file.")
        return 2
    for name in paths:
        path = Path(name).expanduser()
        text = path.read_text(encoding="utf-8") if path.exists() else ""
        current = front_matter(text).get("bookmarks") or {}
        chosen_scope = scope or current.get("scope", "")
        block = [
            "bookmarks:",
            f"  scope: {chosen_scope}",
            f"  default_section: {default_section}",
            f"  order: {order}",
        ]
        if not scope and not current:
            print(f"{path}: no scope given, would write:\n" + "\n".join(block))
            print("  rerun with --scope 'what belongs in this file'")
            continue
        path.write_text(splice_front_matter(text, block), encoding="utf-8")
        print(f"{path}: front matter written (scope, default_section, order)")
    return 0


def cmd_add(url: str, args: argparse.Namespace, sinks: list[Sink]) -> int:
    if not re.match(r"^https?://", url):
        print(f"refused: {url} is not an http(s) url")
        return 2
    if not sinks:
        print("no sinks: nothing has bookmarks: front matter (bookmark describe FILE)")
        return 2
    found = existing(url, sinks)
    if found and not args.force:
        sink, line = found
        print(f"refused: already in {sink.short}:{line}. Use --force to add it again.")
        return 1

    title = args.title or fetch_title(url)
    sink = None
    section = args.section
    if args.to:
        sink = next((s for s in sinks if str(s.path).endswith(args.to) or s.path == Path(args.to).expanduser()), None)
        if sink is None:
            print(f"refused: {args.to} is not a sink. bookmark list shows the sinks.")
            return 2
    elif not args.no_jev:
        try:
            routed = route_by_jev(url, title, sinks)
        except (RuntimeError, OSError) as error:
            print(f"jev unavailable ({error}); falling back to the picker")
            routed = None
        if routed:
            sink, section = routed[0], args.section or routed[1]
    if sink is None:
        labels = [sink_line(s) for s in sinks]
        chosen = pick(labels, "bookmark file")
        if chosen is None:
            print("no route: no terminal for a picker and no confident Jev answer. Pass --to FILE:")
            for label in labels:
                print("  " + label)
            return 2
        sink = sinks[labels.index(chosen)]
    if section is None:
        section = sink.default_section
        if len(sink.sections) > 1:
            picked = pick([f"{sink.short} :: {name}" for name in sink.sections], "section")
            if picked:
                section = picked.split(":: ", 1)[1]
    if section not in sink.sections and section != sink.default_section and not args.new_section:
        print(f"refused: {section!r} is not a heading in {sink.short}. Add --new-section to create it.")
        return 2

    entry = f"- [{title}]({url})"
    updated = "\n".join(new_lines(sink, section, entry)) + "\n"
    return write(sink, updated, entry, section, args)


def write(sink: Sink, updated: str, entry: str, section: str, args: argparse.Namespace) -> int:
    added = sum(1 for line in updated.splitlines() if LINK.match(line)) - sum(
        1 for line in sink.text.splitlines() if LINK.match(line)
    )
    if args.dry_run:
        print(f"dry run: would add to {sink.short} under {section!r}:\n  {entry}\n  (+{added} link)")
        return 0
    sink.path.write_text(updated, encoding="utf-8")
    if args.json:
        print(json.dumps({"file": str(sink.path), "section": section, "line": entry, "added": added}))
    else:
        print(f"added to {sink.short} under {section!r}:")
        print(f"  {entry}")
    return 0


def entries(sinks: list[Sink]) -> list[dict]:
    found = []
    for sink in sinks:
        section = ""
        for line in sink.text.splitlines():
            if (match := HEADING.match(line)):
                section = match.group(1)
                continue
            if (match := LINK.match(line)):
                url = match.group(2) or match.group(3)
                found.append(
                    {
                        "title": match.group(1) or url,
                        "url": url,
                        "file": sink.short,
                        "section": section,
                    }
                )
    return found


def cmd_open(sinks: list[Sink], as_json: bool = False) -> int:
    """fzf when a terminal is attached, otherwise print the links.

    Inside an agent harness there is no /dev/tty, so the print path is the one
    that runs: plain url-first lines, greppable and copyable, no picker needed.
    """
    links = entries(sinks)
    if as_json:
        print(json.dumps(links, indent=1))
        return 0 if links else 1
    if not links:
        print("no links found in any sink")
        return 1
    if not has_tty():
        for entry in links:
            print(f"{entry['url']}\t[{entry['file'].rsplit('/', 1)[-1]} :: {entry['section']}]\t{entry['title'][:80]}")
        print(
            f"{len(links)} links across {len(sinks)} sinks. No terminal, so nothing was opened. "
            "Add with: bookmark URL. Open one with: open URL"
        )
        return 0
    labels = [f"{e['title'][:70]}  [{e['file'].rsplit('/', 1)[-1]} :: {e['section']}]" for e in links]
    chosen = pick(labels, "open")
    if chosen is None:
        print("nothing selected")
        return 0
    subprocess.run(["open", links[labels.index(chosen)]["url"]], check=False)
    return 0


def add_open_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="bookmark", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("url", nargs="?", help="the link to add; omit to browse every sink")
    parser.add_argument("--to", help="sink path or its tail, e.g. work/bookmarks.md")
    parser.add_argument("--section", help="section heading to place it under")
    parser.add_argument("--title", help="link text; default is the page title")
    parser.add_argument("--new-section", action="store_true", help="allow creating a missing section")
    parser.add_argument("--force", action="store_true", help="add even when the url is already in a sink")
    parser.add_argument("--no-jev", action="store_true", help="never call Jev; picker or --to only")
    parser.add_argument("--dry-run", action="store_true", help="print the placement, write nothing")
    parser.add_argument("--json", action="store_true", help="machine-readable result")
    return parser


def main() -> int:
    argv = sys.argv[1:]
    # dispatched by hand, not by add_subparsers: those reject a global flag after
    # the subcommand, so `bookmark list --json` would fail
    if argv[:1] == ["list"]:
        parser = argparse.ArgumentParser(prog="bookmark list", description="The sinks: their scope, their counts, their order.")
        parser.add_argument("--json", action="store_true", help="link objects instead of the human table")
        return cmd_list(discover(), parser.parse_args(argv[1:]).json)
    if argv[:1] == ["check"]:
        argparse.ArgumentParser(
            prog="bookmark check",
            description="Validate the protocol across every sink: an empty scope, a bad order, a duplicate, a non-http link. Notes (a default section not created yet) do not fail it.",
        ).parse_args(argv[1:])
        return cmd_check(discover())
    if argv[:1] == ["describe"]:
        parser = argparse.ArgumentParser(
            prog="bookmark describe",
            description="Write or update the bookmarks: front matter. This is how a file becomes a sink. Other front matter keys are kept byte for byte.",
        )
        parser.add_argument("files", nargs="+", help="one file per run when --scope is given")
        parser.add_argument("--scope", help="one sentence saying what belongs in this file; the whole input Jev gets about it")
        parser.add_argument("--default-section", default="Read Later", help="where a link goes when no section was chosen (default: Read Later)")
        parser.add_argument("--order", default="newest-last", help="newest-last or newest-first (default: newest-last)")
        # intermixed: `describe --scope X FILE FILE` and `describe FILE FILE --scope X` both parse
        parsed = parser.parse_intermixed_args(argv[1:])
        return cmd_describe(parsed.files, parsed.scope, parsed.default_section, parsed.order)

    args = add_open_parser().parse_args(argv)
    sinks = discover()
    if args.url:
        return cmd_add(args.url, args, sinks)
    return cmd_open(sinks, args.json)


if __name__ == "__main__":
    sys.exit(main())
