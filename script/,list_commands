#!/usr/bin/env bash
# ,list_commands - list every command you can run, one per line, sorted.
#
# Usage:
#   ,list_commands
#   ,list_commands | rg git
#
# Covers aliases, functions, builtins, keywords and programs on PATH, read
# from a fresh interactive Bash so your aliases and functions are included.
# Use `type NAME` to see what one of them is.

set -euo pipefail
IFS=$'\n\t'

case "${1:-}" in -h|--help) sed -n '2s/^# \{0,1\}//p' "$0"; exit 0;; help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0;; esac

bash -ic 'compgen -A function -abck | sort -u' 2>/dev/null
