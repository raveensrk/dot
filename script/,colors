#!/usr/bin/env bash
# ,colors - print reference sheets of ANSI terminal color codes, each in its color.
#
# Usage:
#   ,colors
#
# Two sheets: color names with sample text in 16 and 256 colors (white, black and
# cyan text on each background), then the bare codes as numbers.
#
# Opened by the :Colors command in Vim (config/vim/plugin/appearance.vim).

case "${1:-}" in -h|--help) sed -n '2s/^# \{0,1\}//p' "$0"; exit 0;; help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0;; esac

cat <<HERE
------------------------------------------------------------------------------   
ANSI COLOR CODES
------------------------------------------------------------------------------   
16-bit colors
------------------------------------------------------------------------------   
\e[i]m
HERE

{
for ((i=30;i<=47;i++)); do
    echo -e "$i = \e[${i}mColor\e[0m"
done
} | column -x

cat <<HERE
------------------------------------------------------------------------------   
256 bit colors
------------------------------------------------------------------------------   
\e[38;5;im is foreground
\e[48;5;im is background

White on color
====================
HERE

{
for ((i=0;i<256;i++)); do
    echo -e "$i = \e[38;5;${i}mColor\e[0m \e[48;5;${i}mColor\e[0m"
done
} | column -x

cat <<HERE
------------------------------------------------------------------------------   
256 bit colors
------------------------------------------------------------------------------   
\e[38;5;im is foreground
\e[48;5;im is background

Black on color
====================
HERE

{
for ((i=0;i<256;i++)); do
    echo -e "$i = \e[48;5;${i}m\e[38;5;0mColor\e[0m"
done
} | column -x

# Bare codes as numbers.
echo -----------------------
echo "\e[{i}m"
echo -----------------------
for i in $(seq 0 9) $(seq 21 47) $(seq 90 110); do
	echo -n -e "\e[${i}m${i}\e[0m"
done
echo ""
echo -----------------------
echo "\e[38;5;{i}m{i}\e[0m"
echo -----------------------
for i in $(seq 0 255); do
	if [ $((i % 2)) -eq 0 ]; then
		echo -n -e "\e[4m"
	fi
	echo -n -e "\e[38;5;${i}m${i}\e[0m"
done
echo ""
echo -----------------------
echo "\e[38;5;0m\e[48;5;{i}m{i}\e[0m"
echo -----------------------
for i in $(seq 0 255); do
	if [ $((i % 2)) -eq 0 ]; then
		echo -n -e "\e[4m"
	fi
	echo -n -e "\e[38;5;0m\e[48;5;${i}m${i}\e[0m"
done
echo ""
echo -----------------------
echo "\e[38;5;255m\e[48;5;{i}m{i}\e[0m"
echo -----------------------
for i in $(seq 0 255); do
	if [ $((i % 2)) -eq 0 ]; then
		echo -n -e "\e[4m"
	fi
	echo -n -e "\e[38;5;255m\e[48;5;${i}m${i}\e[0m"
done
echo ""

# Cyan text on every background.
cat <<HERE
------------------------------------------------------------------------------
Cyan on color
====================
HERE

{
for ((i=0;i<256;i++)); do
    echo -e "$i = \e[38;5;6m\e[48;5;${i}mCyan\e[0m"
done
} | column -x
