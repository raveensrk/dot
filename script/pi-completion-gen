#!/usr/bin/env python3
"""Generate bash completions for pi by parsing `pi --help` output.

Writes $DOT/config/pi-completion.sh (or argv[1]). Refuses to overwrite when
parsing yields too little, so a help-format change keeps the old file.
"""
import os
import re
import subprocess
import sys
import tempfile

MIN_FLAGS = 5
MIN_SUBS = 3


USAGE_FLAG = re.compile(r"\[([^-\]]*[-][^\]]*)\]")


def flags_from_usage(text):
    """Flags mentioned as brackets in usage lines, e.g. [--provider <p>].
    For subcommands whose help has no Options: block (pi auth)."""
    out = []
    for line in text.splitlines():
        if not line.startswith("  pi "):
            continue
        chunk = re.split(r"\s{2,}", line.strip())[0]
        for group in USAGE_FLAG.findall(chunk):
            for tok in group.split():
                tok = tok.rstrip(",")
                if re.fullmatch(r"-{1,2}[a-zA-Z][a-zA-Z0-9-]*", tok) and tok not in out:
                    out.append(tok)
    return out


def run_pi(*args):
    out = subprocess.run(["pi", *args], capture_output=True, text=True, timeout=60)
    if out.returncode != 0 or not out.stdout.strip():
        raise RuntimeError(f"pi {' '.join(args)} failed: {out.stderr.strip()[:200]}")
    return out.stdout


def parse_help(text):
    """Return (flags, subcommands, nested) parsed from a pi --help block."""
    lines = text.splitlines()
    flags, subs = [], []
    in_options = False
    for line in lines:
        if re.match(r"^Options:\s*$", line):
            in_options = True
            continue
        if in_options:
            chunk = re.split(r"\s{2,}", line.strip())[0]
            for tok in chunk.split():
                tok = tok.rstrip(",")
                if tok.startswith("-") and len(tok) >= 2 and tok != "--" and tok not in flags:
                    flags.append(tok)
        else:
            m = re.match(r"^  pi ([a-z][a-z0-9-]*)\b", line)
            if m and m.group(1) not in subs:
                subs.append(m.group(1))
    # nested subcommands: "pi <sub> <word>" lines in usage; word must be a
    # bare literal (rules out <source>, npm:@foo/bar, [--provider])
    nested = {}
    word = re.compile(r"^[a-z][a-z0-9-]*$")
    for line in lines:
        m = re.match(r"^  pi (\S+) (\S+)(?:\s|$)", line)
        if m and word.match(m.group(1)) and word.match(m.group(2)) and m.group(2) != "help":
            nested.setdefault(m.group(1), [])
            if m.group(2) not in nested[m.group(1)]:
                nested[m.group(1)].append(m.group(2))
    return flags, subs, nested


def emit(main_flags, subs, sub_flags, nested):
    cmds = " ".join(subs)
    out = [
        "# GENERATED by pi-completion-gen -- do not edit by hand; rerun generator.",
        "# pi binary newer than this file triggers regeneration in config/bashrc.",
        "_pi() {",
        '  local cur c1 sf sc',
        '  cur="${COMP_WORDS[COMP_CWORD]}"',
        '  c1="${COMP_WORDS[1]}"',
        f'  local flags="{" ".join(main_flags)}"',
        f'  local cmds="{cmds}"',
        "  if (( COMP_CWORD == 1 )); then",
        '    COMPREPLY=($(compgen -W "$cmds $flags" -- "$cur"))',
        "    return",
        "  fi",
        "  case \"$c1\" in",
    ]
    for s in subs:
        nf = " ".join(nested.get(s, []))
        out.append(f"    {s}) sf=\"{sub_flags[s]}\" sc=\"{nf}\" ;;")
    out += [
        "    *) sf=\"$flags\" sc=\"\" ;;",
        "  esac",
        "  if (( COMP_CWORD == 2 )) && [[ -n \"$sc\" ]]; then",
        '    COMPREPLY=($(compgen -W "$sc $sf" -- "$cur"))',
        "    return",
        "  fi",
        '  COMPREPLY=($(compgen -W "$sf" -- "$cur"))',
        "}",
        "complete -o bashdefault -o default -F _pi pi",
    ]
    return "\n".join(out) + "\n"


def main():
    target = sys.argv[1] if len(sys.argv) > 1 else os.path.join(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
        "config", "pi-completion.sh")

    main_flags, subs, nested = parse_help(run_pi("--help"))
    if len(main_flags) < MIN_FLAGS or len(subs) < MIN_SUBS:
        sys.exit(f"parse too small ({len(main_flags)} flags, {len(subs)} subs); keeping old file")

    sub_flags = {}
    for s in subs:
        try:
            sfl, _, snested = parse_help(run_pi(s, "--help"))
        except RuntimeError:
            continue  # sub may not support --help; main flags fallback
        for k, v in snested.items():
            nested.setdefault(k, [])
            nested[k] += [x for x in v if x not in nested[k]]
        if not sfl:
            sfl = flags_from_usage(run_pi(s, "--help"))
        sub_flags[s] = " ".join(sfl)
    for s in subs:
        sub_flags.setdefault(s, "$flags")

    script = emit(main_flags, subs, sub_flags, nested)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target))
    with os.fdopen(fd, "w") as f:
        f.write(script)
    os.replace(tmp, target)
    print(f"wrote {target}: {len(main_flags)} flags, {len(subs)} subs")


if __name__ == "__main__":
    main()
