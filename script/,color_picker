#!/usr/bin/env bash
# ,color_picker - pick a terminal color with fzf and print its escape code to paste.
#
# Usage:
#   ,color_picker
#
# Type to filter the 256 text colors and 256 background colors, then Enter.
# A text color prints a ready-to-paste shell function; a background color
# prints its code. Needs fzf.

case "${1:-}" in -h|--help) sed -n '2s/^# \{0,1\}//p' "$0"; exit 0;; help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0;; esac

string="The Quick brown fox jumped over the lazy dog..."

{
for ((i=0;i<256;i++)); do
    echo -en "$i = \e[38;5;${i}m$string\e[0m"
    cat <<-HERE
	:color () { echo -e "\\e[38;5;${i}m" ;}
	HERE
done
for ((i=0;i<256;i++)); do
    echo -en "$i = \e[48;5;${i}m$string\e[0m"
    echo ": Code='\e[48;5;${i}mText\e[0m'"
done
} | fzf +s --ansi | cut -d ":" -f 2

cat <<-HERE
no_color () { echo -e "\\e[0m" ;}
HERE

exit 0
