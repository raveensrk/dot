#!/usr/bin/env bash
# ,reading_list - run the reading_list Go tool, rebuilding it when its source changed.
#
# The source is reading_list_go/ next to this file. It is rebuilt first when
# the source is newer than the binary, as after a git pull or an edit. The
# binary lives outside the repo.
#
# A normal call costs ~11 ms over the binary (measured 2026-10-11: 15.1 ms vs
# 4.1 ms, against 52.7 ms for the same job in Python). The first call after a
# change runs `go build` once. Help: ,reading_list -h | --help | help
set -euo pipefail

src="$HOME/dot/script/reading_list_go"
bin="$HOME/.cache/dot_bin/reading_list"

stale=
[[ -x $bin ]] || stale=1
for f in "$src"/*.go "$src"/go.mod "$src"/go.sum; do
	[[ $f -nt $bin ]] && stale=1 && break
done
if [[ -n $stale ]]; then
	mkdir -p "${bin%/*}"
	echo ",reading_list: source changed, rebuilding..." >&2
	(cd "$src" && go build -o "$bin" .)
fi

case "${1:-}" in
	-h | --help | help) exec "$bin" help ;;
esac
exec "$bin" "$@"
