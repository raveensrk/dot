#!/usr/bin/env bash
# Run a himalaya command for every account, one section per account.
# Usage: himalaya-all [command...] [flags]   (default command: envelope list)
#   himalaya-all                     # envelope list for all accounts
#   himalaya-all -s 20               # same as: himalaya-all envelope list -s 20
#   himalaya-all folder list
# `-a <account>` is appended per account. One failing account prints its error
# and the rest still run; exit code is 1 if any failed.

set -PCeuo pipefail
IFS=$'\n\t'

# Hide harmless imap_codec "Rectified missing `text`" warnings.
export RUST_LOG="${RUST_LOG:-error}"

if [ "$#" -eq 0 ] || [[ "$1" == -* ]]; then
  set -- envelope list "$@"
fi

status=0
for account in $(himalaya account list -o json | jq -r '.[].name'); do
  echo "== $account"
  himalaya "$@" -a "$account" || status=1
  echo
done
exit "$status"
