#!/usr/bin/env bash
# ,ls_comma_cmds - list every comma command with a one-line description and where it lives.

set -PCeuo pipefail
# set -x
IFS=$'\n\t'

usage() {
	cat <<'EOF'
Usage: ,ls_comma_cmds [-h|--help|help]

List every command that starts with a comma, sorted by path: executables on PATH,
plus aliases and functions from an interactive Bash, with a one-line description
and where each lives.
Output is colored on a terminal; set NO_COLOR to turn it off.

The description is read from the script's header (its first comment or docstring
sentence), never by running it. A compiled command has no header: those listed in
HELP_SAFE_BINARIES (checked to have no side effects) give the first line of their
--help instead, capped at 2 seconds. For an alias it is what the alias runs.

Example:
  ,ls_comma_cmds
EOF
}

case "${1-}" in
-h | --help | help)
	usage
	exit 0
	;;
'') ;;
*)
	usage >&2
	exit 2
	;;
esac

# shellcheck source=../lib/cmd_info.sh
source "${DOT:-$HOME/dot}/lib/cmd_info.sh"

# Every comma name the interactive Bash can complete, sorted by where it lives.
bash -ic 'compgen -c -- ,' 2>/dev/null | sort -u | cmd_lookup | sort -t $'\t' -k2,2 -k1,1 |
	cmd_describe_rows | cmd_table
