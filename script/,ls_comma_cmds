#!/usr/bin/env bash
# ,ls_comma_cmds - list every comma command with a one-line description and where it lives.

set -PCeuo pipefail
# set -x
IFS=$'\n\t'

usage() {
	cat <<'EOF'
Usage: ,ls_comma_cmds [-h|--help|help]

List every command that starts with a comma, sorted by path: executables on PATH,
plus aliases and functions from an interactive Bash, with a one-line description
and where each lives.

The description is read from the script's header (its first comment or docstring
line), never by running it. For an alias it is what the alias runs.

Example:
  ,ls_comma_cmds
EOF
}

case "${1-}" in
-h | --help | help)
	usage
	exit 0
	;;
'') ;;
*)
	usage >&2
	exit 2
	;;
esac

# describe NAME FILE: the first meaningful header line, without "NAME - ".
describe() {
	local name=$1 file=$2 line
	if ! grep -Iq . "$file" 2>/dev/null; then
		echo "(compiled binary)"
		return
	fi
	# The header's first paragraph, joined into one line: comment lines, or a
	# docstring's lines, up to a blank line or the first line of code.
	line=$(sed -n '2,30p' "$file" | awk '
		function add(s) { out = out (out == "" ? "" : " ") s }
		function done() { if (out != "") { print out; exit } }
		/^# \/\/\/|^# dependencies|^# requires-python/ { next }
		/^#[[:space:]]*(set |shellcheck|-\*-|coding[:=])/ { next }
		doc { sub(/"""[[:space:]]*$/, ""); if (!NF) done(); add($0); if (end) done(); next }
		/^"""/ { sub(/^"""[[:space:]]*/, ""); end = sub(/"""[[:space:]]*$/, ""); doc = 1; if (NF) add($0); if (end) done(); next }
		/^#/ { sub(/^#[[:space:]]*/, ""); if (!NF) done(); add($0); next }
		{ done(); exit }
		END { if (out != "") print out }
	' | head -1)
	line=${line#"$name - "}
	# Keep the first sentence: up to the first ". " (a period followed by a space).
	line=${line%%. *}
	line=${line%.}
	echo "${line:-(no description)}"
}

# Interactive Bash so aliases and functions from the profile are visible.
rows=$(bash -ic '
	compgen -c -- , | sort -u | while IFS= read -r c; do
		if p=$(type -P -- "$c"); then
			printf "%s\t%s\t\n" "$c" "$p"
		elif [ "$(type -t -- "$c")" = alias ]; then
			printf "%s\talias\t%s\n" "$c" "$(alias -- "$c" | sed "s/^[^=]*=//; s/^'"'"'//; s/'"'"'$//")"
		else
			printf "%s\t%s\t\n" "$c" "$(type -t -- "$c")"
		fi
	done
' 2>/dev/null | sort -t $'\t' -k2,2 -k1,1)

while IFS=$'\t' read -r name where detail; do
	if [ -f "$where" ]; then
		desc=$(describe "$name" "$where")
		where=${where/#$HOME/\~}
	elif [ "$where" = alias ]; then
		desc="runs: $detail"
	else
		desc="($where)"
	fi
	printf '%s\t%s\t%s\n' "$name" "$where" "$desc"
done <<<"$rows" | awk -F'\t' '
	{ n[NR] = $1; w[NR] = $2; d[NR] = $3
	  if (length($1) > a) a = length($1); if (length($2) > b) b = length($2) }
	END { for (i = 1; i <= NR; i++) printf "%-" a "s  %-" b "s  %s\n", n[i], w[i], d[i] }
'
