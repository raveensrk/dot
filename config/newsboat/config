# ═══════════════════════════════════════════════════════════════════════
# Theme: "Chrome Teal" - cyberpunk, dark, low eye strain
#
# Design rules this theme follows:
#   1. Neon is an accent, never a surface. Article body text is soft
#      off-white (color252); saturated teal/magenta appear only on the
#      selection bar, the info bar, unread rows and inline accents.
#   2. The selection bar is a DARK saturated block (color23), not a bright
#      one. Bright inverted bars are the largest strain source in TUIs.
#   3. No pure black, no pure white. Backgrounds inherit the terminal,
#      foregrounds top out at color252.
#   4. Hierarchy comes from dimming (color240/245), not from more hue.
#      Only two hue families are in play: teal and magenta.
#   5. Mid-luminance neons (80/117/176/213), never color51/color201.
#
# Palette
#   color252  article body       color245  header labels / dim
#   color240  read rows          color80   primary teal (header values)
#   color117  unread rows (cyan) color195  pale teal (selection fg)
#   color176  magenta (links)    color213  bright pink (titles, keys)
#   color23   deep teal (sel bg) color150  acid green (quotes, code)
#   color215  amber (ALL-CAPS)
# ═══════════════════════════════════════════════════════════════════════

# ── Base surfaces ──────────────────────────────────────────────────────
# `default` background everywhere so newsboat inherits the terminal's
# colorscheme and any transparency instead of painting its own rectangle.
color background            color252  default
color article               color252  default
color end-of-text-marker    color240  default  dim

# ── Lists ──────────────────────────────────────────────────────────────
# Read vs unread is signalled ONLY by color - there is no N marker and no
# unread count in the list formats. Read rows recede to dark gray; unread
# rows are cyan and bold, so unread is what the eye lands on first.
color listnormal            color240  default
color listnormal_unread     color117  default  bold
color listfocus             color195  color23
color listfocus_unread      color195  color23  bold

# ── Chrome ─────────────────────────────────────────────────────────────
# The info bar is the one deliberately "lit" strip on screen.
color info                  color117  color23  bold
color title                 color213  default  bold

# ── Help / hint bar ────────────────────────────────────────────────────
# These are drawn ON TOP of the `info` bar, so they must share its
# background (color23). Using `default` here punches black holes in the
# teal strip and makes the bar look like patchwork.
color hint-key              color213  color23  bold
color hint-keys-delimiter   color80   color23
color hint-separator        color80   color23
color hint-description      color195  color23

# ═══════════════════════════════════════════════════════════════════════
# Layout & format strings
# ═══════════════════════════════════════════════════════════════════════

# No `N` marker and no (unread/total) counts. Read vs unread is carried
# entirely by color: cyan for unread, dark gray for read (see the list
# colors above), so nothing else competes for attention.
#
# Separators are box-drawing `│`, which is single-width and keeps the
# date column aligned. Nerd Font glyphs are confined to the title bars,
# where a double-width glyph cannot push a column out of alignment.
feedlist-format             "%t"
articlelist-format          "%-12D │ %t"

# Every segment is separated by the same " │ " so the gaps are even.
feedlist-title-format       "%N %V │ %?F?Feeds&Your feeds? │ %u unread of %t%?F? │ filter '%F'&?%?T? │ %T&?"
articlelist-title-format    "%N %V │ %T │ %u unread of %t%?F? │ filter '%F'&?"
searchresult-title-format   "%N %V │ Search results │ %u unread of %t"
itemview-title-format       "%N %V │ %T"
help-title-format           "%N %V │ ﰊ Help │ keybindings"
urlview-title-format        "%N %V │ Links in this article"
dialogs-title-format        "%N %V │ Open dialogs"
selecttag-title-format      "%N %V │ Select tag"
selectfilter-title-format   "%N %V │ Select filter"
filebrowser-title-format    "%N %V │ %?O?Open file&Save file? │ %f"
dirbrowser-title-format     "%N %V │ Select directory │ %f"

# ── Readability ────────────────────────────────────────────────────────
# Only settings that actually differ from the newsboat defaults. Options
# set to their own default value were removed as no-ops.
text-width 92               # cap measure; long lines are the real strain source
scrolloff 3                 # keep context above/below the cursor
datetime-format "%b %d %H:%M"

# Feeds appear in the same order as the urls file. `none` is the default,
# but it is set explicitly so a future sort option isn't added by accident.
feed-sort-order none

# Newsboat defaults to lynx when BROWSER is unset, which exits 127 if it
# isn't installed. open_url ($DOT/script) picks $BROWSER / open / xdg-open,
# since newsboat's config format has no OS conditionals.
browser "open_url %u"

# ═══════════════════════════════════════════════════════════════════════
# Highlighting
# Newsboat applies the LAST matching rule, so general patterns come first
# and specific ones come after.
# ═══════════════════════════════════════════════════════════════════════

# ── Article body ───────────────────────────────────────────────────────
highlight article "^(Feed|Title|Author|Link|Date|Flags):.*$"     color80   default  bold
highlight article "^(Feed|Title|Author|Link|Date|Flags):"        color245  default
highlight article "https?://[^ \t\"'<>()]+"                      color176  default  underline
highlight article "\\[[0-9]+\\]"                                 color213  default  bold
highlight article "^ *([*+-]|[0-9]+[.)]) "                       color240  default  dim
highlight article "^ *>.*$"                                      color150  default
highlight article "`[^`]+`"                                      color150  default
highlight article "\\b[A-Z][A-Z0-9_]{3,}\\b"                     color215  default

# ── NOTE: no highlight rules on the list views ─────────────────────────
# Deliberately absent. Any `highlight feedlist/articlelist` or
# `highlight-article/-feed` rule paints its own fg/bg over the matched
# characters, and that OVERRIDES `listfocus`. The result is a selection
# bar that only colors the blank padding after the text, with the row
# content and the │ separators left on the default background.
#
# The built-in listnormal/listnormal_unread/listfocus/listfocus_unread
# elements already distinguish read from unread AND respect focus, so
# they do this job correctly. Do not add list highlight rules here.
#
# `highlight article` (below/above, for the article BODY) is unaffected -
# the body has no focus bar to clobber.
