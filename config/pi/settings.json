{
  "theme": "dark",
  "enableInstallTelemetry": false,
  "defaultProvider": "xai",
  "defaultModel": "grok-4.7",
  "hideThinkingBlock": false,
  "defaultTools": [
    "+codemode"
  ],
  "extensions": [
    "+builtin:mcp"
  ],
  "packages": [
    "npm:pi-web-access",
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:pi-powerline-footer",
    "npm:@narumitw/pi-usage",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-caveman",
    "npm:@injaneity/pi-computer-use",
    "npm:pi-ask-user",
    "npm:@narumitw/pi-worktree",
    "npm:pi-subagents",
    "npm:pi-thinking-box",
    "~/dot/config/pi",
    "~/repos/agent1"
  ],
  "defaultThinkingLevel": "xhigh",
  "powerline": {
    "preset": "default",
    "placement": "above",
    "welcome": false,
    "path": {
      "mode": "full"
    },
    "cost": {
      "subscriptionDisplay": "both",
      "currency": "USD"
    },
    "model": {
      "display": "qualified"
    },
    "layout": {
      "left": [
        "custom:session-name",
        "model",
        "thinking",
        "path",
        "git",
        "cost",
        "context_pct"
      ],
      "right": [],
      "secondary": [
        "custom:usage",
        "custom:openrouter",
        "custom:grok",
        "custom:opencode"
      ]
    },
    "customItems": [
      {
        "id": "session-name",
        "statusKey": "session-name",
        "position": "left",
        "hideWhenMissing": true
      },
      {
        "id": "usage",
        "statusKey": "openai-usage",
        "position": "secondary",
        "selfColorize": true
      },
      {
        "id": "openrouter",
        "statusKey": "or-spend",
        "position": "secondary",
        "prefix": "openrouter",
        "color": "#cfb985"
      },
      {
        "id": "grok",
        "statusKey": "grok-credits",
        "position": "secondary",
        "color": "#c4b5a0"
      },
      {
        "id": "opencode",
        "statusKey": "oc-usage",
        "position": "secondary",
        "prefix": "opencode",
        "color": "#8fb8d8"
      }
    ]
  },
  "enabledModels": [
    "openrouter/~deepseek/deepseek-flash-latest",
    "openrouter/~z-ai/glm-flash-latest",
    "openrouter/auto",
    "openrouter/deepseek/deepseek-v4.1-flash",
    "openrouter/z-ai/glm-5.3-flash",
    "xai/grok-4.7",
    "opencode/deepseek-v4.1-flash",
    "opencode/glm-5.3-flash",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna",
    "openrouter/anthropic/claude-opus-5.5",
    "opencode-go/deepseek-v4.1-flash",
    "opencode/gpt-6.1-sol",
    "openrouter/openai/gpt-6-sol"
  ]
}
