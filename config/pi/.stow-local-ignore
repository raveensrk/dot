# Stow ignore list for the pi package.
#
# NOTE: a local ignore file REPLACES stow's built-in ignore list, so the
# defaults are copied here. Keep in sync with dot_stow.DEFAULT_IGNORE.

RCS
.+,v

CVS
\.\#.+       # CVS conflict files / emacs lock files
\.cvsignore

\.svn
_darcs
\.hg

\.git
\.gitignore
\.gitmodules

.+~          # emacs backup files
\#.*\#       # emacs autosave files

^/README.*
^/LICENSE.*
^/COPYING

# macOS metadata.
\.DS_Store$
